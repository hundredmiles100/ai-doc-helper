DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dochelper
# for local dev without postgres, leave empty and it falls back to sqlite
# DATABASE_URL=sqlite:///./dochelper.db
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Groq free: OPENAI_API_KEY=gsk_xxxx  OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile
# Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
# OpenRouter free: OPENAI_BASE_URL=https://openrouter.ai/api/v1  OPENAI_MODEL=meta-llama/llama-3.1-8b:free
OPENAI_BASE_URL=https://api.groq.com/openai/v1
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
