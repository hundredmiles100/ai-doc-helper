# Production env — copy to hosting dashboard, never commit .env itself
# Backend (Render)
ENV=production
DATABASE_URL=postgresql://user:pass@host:5432/dochelper  # from Neon/Supabase or Render Postgres
# Groq FREE (no billing): console.groq.com → Create API key → gsk_... (14k req/day)
OPENAI_API_KEY=gsk-...  # or sk-proj-... for OpenAI
OPENAI_MODEL=llama-3.3-70b-versatile  # Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
OPENAI_BASE_URL=https://api.groq.com/openai/v1  # Groq free base, for OpenAI use https://api.openai.com/v1 or leave empty
MAX_UPLOAD_MB=20

# Frontend (Vercel) — optional if using separate domains
VITE_API_URL=https://ai-doc-helper-backend.onrender.com
# vercel.json rewrites /api to backend, so no VITE_API_URL needed if same rewrites

# Local dev (sqlite fallback, no DB needed)
# DATABASE_URL=sqlite:///./dochelper.db
